load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "collectbridge",
    srcs = [
        "runner.go",
        "validation.go",
    ],
    importpath = "github.com/dsx-ai-factory/health-validation/toolkit/internal/collectbridge",
    visibility = ["//toolkit:__subpackages__"],
    deps = [
        "//catalog/health",
        "//collect",
        "//collect/observation",
        "//collect/signals/gpu",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "collectbridge_test",
    srcs = ["runner_test.go"],
    deps = [
        ":collectbridge",
        "//catalog",
        "//catalog/cpu",
        "//catalog/health",
        "//catalog/node",
        "//collect",
        "//collect/observation",
        "//collect/signals/gpu",
        "//toolkit",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
